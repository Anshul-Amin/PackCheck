# Google Gemini API key (Free tier from aistudio.google.com, no credit card required)
GEMINI_API_KEY=your_gemini_api_key_here

# Model configuration (Free-tier safe)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Conservative free-tier rate limits
GEMINI_RPM=5
GEMINI_RPD=250

# Optional Ollama offline model
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_BASE_URL=http://localhost:11434

# Cache directory for repeatable & offline demos
LLM_CACHE_DIR=.cache/llm


